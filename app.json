{
  "expo": {
    "name": "Elmec MFR",
    "slug": "elmec",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/branding/logo.png",
    "scheme": "elmec",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "extra": {
      "eas": {
        "projectId": "96c91e46-dc10-43b5-9cd9-4d91217fd50c"
      },
      "router": {
        "origin": "https://your-app.netlify.app/"
      }
    },
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/branding/logo.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://your-app.netlify.app/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "La app necesita acceso a tus fotos para adjuntar imágenes a las solicitudes.",
          "cameraPermission": "La app necesita acceso a tu cámara para tomar fotos y adjuntarlas a las solicitudes."
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/branding/logo.png",
          "color": "#ffffff",
          "defaultChannel": "default",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.elmec.mfr",
      "minSdkVersion": 24,
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/branding/logo.png",
        "backgroundColor": "#ffffff"
      }
    },
    "owner": "softvibeslab"
  }
}
