# Supabase Configuration

# URL del proyecto Supabase (Settings > API > Project URL)
EXPO_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"

# Clave anónima pública (Settings > API > anon public)
EXPO_PUBLIC_SUPABASE_ANON_KEY="your_anon_public_key"

# Service Role Key (Settings > API > Service role key)
# IMPORTANTE: usar solo en scripts/servidor. NO exponer en el cliente.
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key"

# Contraseña temporal para cuentas nuevas (opcional)
DEFAULT_TEMP_PASSWORD="ChangeMe123!"

# Entorno de la app
EXPO_PUBLIC_ENVIRONMENT=development
# Habilita login básico sin Supabase Auth (true/false)
EXPO_PUBLIC_BASIC_AUTH=false
EXPO_PUBLIC_OFFLINE_MODE=false
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
EXPO_PUBLIC_EAS_PROJECT_ID=elmec-mobile-app-demo

# Environment
EXPO_PUBLIC_ENVIRONMENT=development

# Para deploy en producción, cambia a:
# EXPO_PUBLIC_ENVIRONMENT=production

# ============================================
# Firebase Configuration (Hybrid Architecture)
# ============================================
# Firebase se usa para: Chat grupal, Push Notifications, Crashlytics
# Supabase se mantiene para: Auth, Users, Requests, Direct Chats

# Firebase Project Settings (Firebase Console > Project Settings)
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyCxRVxaBrRpUIYB8rw4apRc0PAF-99eBs0
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=elmec-3ae55.firebaseapp.com
EXPO_PUBLIC_FIREBASE_DATABASE_URL=https://elmec-3ae55-default-rtdb.firebaseio.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=elmec-3ae55
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=elmec-3ae55.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=62591188963
EXPO_PUBLIC_FIREBASE_APP_ID=1:62591188963:web:ae989e006edc01797baad6
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-F8VHKPEKK5

# Feature Flags
EXPO_PUBLIC_USE_FIREBASE_GROUPS=true  # Use Firebase for group chats
EXPO_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=true
EXPO_PUBLIC_ENABLE_CRASHLYTICS=true